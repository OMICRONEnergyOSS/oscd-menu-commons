{
  "name": "@omicronenergy/oscd-menu-commons",
  "version": "0.0.2",
  "description": "OpenSCD Menu Plugin for working with IEC 61850 SCL files.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OMICRONEnergyOSS/oscd-menu-commons.git"
  },
  "bugs": {
    "url": "https://github.com/OMICRONEnergyOSS/oscd-menu-commons/issues"
  },
  "homepage": "https://openscd.org",
  "keywords": [
    "OpenSCD",
    "iec81650"
  ],
  "contributors": [
    "OMICRON Electronics GmbH"
  ],
  "license": "Apache-2.0",
  "exports": {
    ".": "./dist/oscd-menu-commons.js",
    "./oscd-menu-new.js": "./dist/oscd-menu-new.js",
    "./oscd-menu-open.js": "./dist/oscd-menu-open.js",
    "./oscd-menu-save.js": "./dist/oscd-menu-save.js",
    "./oscd-menu-undo.js": "./dist/oscd-menu-undo.js",
    "./oscd-menu-redo.js": "./dist/oscd-menu-redo.js",
    "./oscd-menu-file-close.js": "./dist/oscd-menu-file-close.js",
    "./oscd-menu-file-rename.js": "./dist/oscd-menu-file-rename.js"
  },
  "files": [
    "/dist/",
    "!/dist/*.spec.*",
    "!/dist/*.test.*"
  ],
  "scripts": {
    "lint": "oscd lint",
    "format": "oscd lint --format",
    "extract": "lit-localize extract",
    "localize": "lit-localize build",
    "start": "npm run extract && npm run localize && oscd start",
    "start:bundle": "oscd start-bundle",
    "build": "npm run extract && npm run localize && oscd build",
    "bundle": "npm run extract && npm run localize && oscd bundle",
    "bundle:watch": "npm run extract && npm run localize && oscd bundle --watch",
    "test": "oscd test",
    "test:watch": "oscd test --watch",
    "test:visual": "oscd test --visual",
    "test:update": "oscd test --update",
    "updates": "oscd updates",
    "deploy": "oscd deploy",
    "prepare": "oscd install-hooks"
  },
  "dependencies": {
    "@lit/localize": "^0.12.2",
    "@omicronenergy/oscd-api": "^0.1.3",
    "@omicronenergy/oscd-background-editv1": "^0.0.6",
    "@omicronenergy/oscd-shell": "^0.0.17",
    "@omicronenergy/oscd-ui": "^0.1.0",
    "@open-wc/scoped-elements": "^3.0.6",
    "@openscd/oscd-api": "^0.1.5",
    "lit": "^3.3.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@lit/localize-tools": "^0.8.0",
    "@omicronenergy/oscd-test-utils": "^0.0.8",
    "@omicronenergy/oscd-tooling": "^0.0.6",
    "@open-wc/testing": "^4.0.0",
    "@types/mocha": "^10.0.10",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@web/test-runner-commands": "^0.9.0",
    "sinon": "^21.0.0"
  }
}
